views {
  view simulationDataFlow {
    title 'Simulation Stages and Data Flow'
    description 'From GeoJSON ingestion through simulation, aggregation, persistence, and GIS export'

    group 'UBEM' {
      color indigo
      opacity 6%
      border solid

      include preprocessing
      include
        feature2Building with {
          navigateTo feature2BuildingDetails
        }

      include
        simulation.precomputeBoundary with {
          navigateTo precomputeBoundaryDetails
        }
      include simulation.zone5R1C
      include
        simulation.resultsAggregation with {
          navigateTo resultsAggregationDetails
        }
    }

    include
      inputs with {
        navigateTo inputsDetails
      }
    include
      definitionTables with {
        navigateTo definitionTablesDetails
      }
    include
      resultTables with {
        navigateTo resultTablesDetails
      }
    include
      gisTables with {
        navigateTo gisTablesDetails
      }
    include resultsGeojson

    exclude feature2Building.energyLoadsArchetype -> simulation.resultsAggregation.siteEnergyResult

    rank same {
      definitionTables, resultTables, gisTables
    }

    autoLayout LeftRight 80 55
  }

  view scenarioSimulationView {
    title 'Scenario Simulation View'
    description 'From processed features and scenario mappings through building upgrades, copied simulation instances, persistence, and GIS export'

    group 'UBEM' {
      color indigo
      opacity 6%
      border solid

      include preprocessing
      include
        feature2Building with {
          navigateTo feature2BuildingDetails
        }
      include scenarioMappings
      include buildingUpgradeScenarios
      include
        simulation with {
          navigateTo simulationDetails
          multiple true
        }
      include baselineSimulation
    }

    include
      inputs with {
        navigateTo inputsDetails
      }
    include
      definitionTables with {
        navigateTo definitionTablesDetails
      }
    include
      resultTables with {
        navigateTo resultTablesDetails
      }
    include
      gisTables with {
        navigateTo gisTablesDetails
      }
    include resultsGeojson

    exclude feature2Building.energyLoadsArchetype -> simulation.resultsAggregation.siteEnergyResult
    exclude feature2Building.zones -> simulation.precomputeBoundary.localWeather

    rank same {
      definitionTables, resultTables, gisTables
    }
    rank same {
      simulation, baselineSimulation
    }

    autoLayout LeftRight 80 55
  }

  view postHocScenarioMixerView {
    title 'Post-hoc Scenario Mixer View'
    description 'From persisted annual results and modeling parameters through modeled mixture selection to a WebUI style update'

    include mixerInput
    include webUI
    include
      resultTables with {
        navigateTo resultTablesDetails
      }
    include
      scenarioMixer.siteEnergyResult with {
        multiple true
      }
    include scenarioMixer.choiceModel
    include scenarioMixer.modeledMixtureSelection
    include scenarioMixer.scenarioResults

    autoLayout LeftRight 80 55
  }

  view inputsDetails of inputs {
    title 'Inputs'
    include *
    autoLayout LeftRight 80 55
  }

  view definitionTablesDetails of definitionTables {
    title 'Definition Tables'
    include *
    autoLayout LeftRight 80 55
  }

  view feature2BuildingDetails of feature2Building {
    title 'Feature2Building (F2B)'
    include *
    include
      feature2Building.zones with {
        navigateTo zonesDetails
      }
    include
      feature2Building.faces with {
        navigateTo facesDetails
      }
    exclude feature2Building.zones -> baselineSimulation
    autoLayout LeftRight 80 55
  }

  view zonesDetails of feature2Building.zones {
    title 'Zones'
    include feature2Building.constructionArchetype
    include feature2Building.systemsArchetype
    include feature2Building.energyLoadsArchetype
    include *
    include
      feature2Building.faces with {
        navigateTo facesDetails
      }
    autoLayout LeftRight 80 55
  }

  view facesDetails of feature2Building.faces {
    title 'Faces'
    include *
    autoLayout LeftRight 80 55
  }

  view simulationDetails of simulation {
    title 'Simulation'
    include *
    include
      simulation.precomputeBoundary with {
        navigateTo precomputeBoundaryDetails
      }
    include
      simulation.resultsAggregation with {
        navigateTo resultsAggregationDetails
      }
    autoLayout LeftRight 80 55
  }

  view precomputeBoundaryDetails of simulation.precomputeBoundary {
    title 'Precompute Boundary Conditions'
    include feature2Building.zones
    include inputs.weather
    include *
    include simulation.zone5R1C
    autoLayout LeftRight 80 55
  }

  view resultsAggregationDetails of simulation.resultsAggregation {
    title 'Results Aggregation'
    include *
    autoLayout LeftRight 80 55
  }

  view resultTablesDetails of resultTables {
    title 'Result Tables'
    include *
    autoLayout LeftRight 80 55
  }

  view gisTablesDetails of gisTables {
    title 'GIS Tables'
    include *
    include resultsGeojson
    autoLayout LeftRight 80 55
  }
}
