model {
  inputs = system 'Inputs' {
    description 'External file and weather inputs'
    icon gcp:user-preferences
    style {
      color amber
      shape person
    }

    inputGeojson = input 'Input GeoJSON' {
      description 'Disk file containing the source geospatial features'
    }

    weather = input 'Weather Input' {
      description 'Weather data used during Zone5R1C simulation'
    }
  }

  preprocessing = stage 'Preprocessing' {
    description 'Schema matching, geometric preprocessing, and archetype assignment'
    icon gcp:dataflow
  }

  feature2Building = stage 'Feature2Building (F2B)' {
    description 'Builds domain objects and archetype assignments from a preprocessed Feature'
    icon gcp:cloud-functions
    style {
      opacity 12%
      border solid
    }

    feature = domainObject 'Feature' {
      description 'Preprocessed geospatial feature used to construct and characterize a Building'
    }

    constructionArchetype = domainObject 'Construction Archetype' {
      description 'Construction properties assigned to ZoneConstruction and Faces'
    }

    systemsArchetype = domainObject 'Systems Archetype' {
      description 'Conditioning-system properties assigned to per-Zone Systems'
    }

    energyLoadsArchetype = domainObject 'Energy Loads Archetype' {
      description 'Energy-load schedules assigned to per-Zone Energy Loads'
    }

    building = domainObject 'Building' {
      description 'Simulation-domain building constructed from Feature geometry'
    }

    zones = domainObject 'Zones' {
      description 'Multiple simulation zones owned by a Building, each with construction, systems, and energy-load components'
      style {
        multiple true
      }

      zoneConstruction = domainObject 'ZoneConstruction' {
        description 'Thermal Mass and Infiltration Rate assigned to a Zone'
      }

      systems = domainObject 'Systems' {
        description 'Conditioning systems assigned to a Zone'
      }

      energyLoads = domainObject 'Energy Loads' {
        description 'Energy-load schedules assigned to a Zone'
      }
    }

    faces = domainObject 'Faces' {
      description 'Multiple geometric faces owned by Zones'
      style {
        multiple true
      }

      materialInfo = data 'Material Info' {
        description 'Material properties associated with a Face'
      }

      contextInfo = data 'Context Info' {
        description 'Contextual information associated with a Face'
      }

      geometryInfo = data 'Geometry Info' {
        description 'Geometric information associated with a Face'
      }

      windowInfo = data 'Window Info' {
        description 'Window information associated with a Face'
      }

    }

    feature -> constructionArchetype 'emits'
    feature -> systemsArchetype 'emits'
    feature -> energyLoadsArchetype 'emits'
    feature -> building 'supplies geometric information'
    building -> zones 'owns'
    zones -> faces 'owns'
    constructionArchetype -> zones.zoneConstruction 'supplies Thermal Mass + Infiltration Rate'
    constructionArchetype -> faces.materialInfo 'supplies U Value + WWR'
    systemsArchetype -> zones.systems 'supplies conditioning systems'
    energyLoadsArchetype -> zones.energyLoads 'supplies schedules'
  }

  definitionTables = system 'Definition Tables' {
    description 'Building and Zone definitions'
    icon gcp:bigtable
    style {
      shape storage
    }

    buildingDefinitionTable = table 'Building Definition Table' {
      description 'Stores Building definitions'
    }

    zoneDefinitionTable = table 'Zone Definition Table' {
      description 'Stores Zone definitions, including energy-load time series'
    }
  }

  simulation = stage 'Simulation' {
    description 'Boundary-condition preparation, Zone5R1C execution, and result aggregation'
    icon gcp:compute-engine

    precomputeBoundary = stage 'Precompute Boundary Conditions' {
      description 'Derives local weather, face radiation, and boundary conditions required by Zone5R1C'
      icon gcp:dataflow

      localWeather = stage 'Local Weather' {
        description 'Resolves zone-local weather conditions from site weather and zone context'
      }

      faceRadiation = stage 'Face Radiation' {
        description 'Computes radiation conditions for zone faces'
      }

      boundaryConditions = stage 'Boundary Conditions' {
        description 'Assembles the boundary conditions consumed by Zone5R1C'
      }

      localWeather -> faceRadiation 'local weather'
      faceRadiation -> boundaryConditions 'surface radiation'
    }

    zone5R1C = stage 'Zone5R1C Simulation' {
      description 'Simulates prepared Zone5R1C objects with weather input'
      icon gcp:compute-engine
    }

    resultsAggregation = stage 'Results Aggregation' {
      description 'Zone, Building, and Site result aggregation'
      icon gcp:big-query

      zoneResult = result 'ZoneResult' {
        description 'Zone-level simulation result'
      }

      buildingResult = result 'BuildingResult' {
        description 'Building-level aggregate result'
      }

      siteEnergyResult = result 'SiteEnergyResult' {
        description 'Site-level aggregate energy result'
      }

      zoneResult -> buildingResult 'aggregates into'
      buildingResult -> siteEnergyResult 'aggregates into'
    }
  }

  baselineSimulation = stage 'Baseline' {
    description 'Reference simulation without scenario upgrades'
    icon gcp:compute-engine
  }

  scenarioMappings = stage 'Scenario Mappings' {
    description 'Apply measure packages based on selection criteria for each scenario'
    icon gcp:workflows
    style {
      multiple true
    }
  }

  buildingUpgradeScenarios = domainObject 'Building Upgrade Scenarios' {
    description 'Building copies with scenario selections and measures applied'
    icon gcp:catalog
    style {
      multiple true
    }
  }

  resultTables = system 'Result Tables' {
    description 'Persistent simulation-result tables'
    icon gcp:big-query
    style {
      shape storage
    }

    zoneResultTable = table 'Zone Result Table' {
      description 'Persists ZoneResult records and boundary results'
    }

    buildingResultTable = table 'Building Result Table' {
      description 'Persists BuildingResult records'
    }

    siteEnergyResultTable = table 'Site Energy Result Table' {
      description 'Persists SiteEnergyResult records'
    }
  }

  mixerInput = system 'Input' {
    description 'Modeling parameters supplied to the post-hoc scenario mixer'
    icon gcp:user-preferences
    style {
      color amber
      shape person
    }
  }

  webUI = ui 'WebUI' {
    description 'Interactive interface for mixer requests and scenario-result styling'
    icon gcp:app-engine
  }

  scenarioMixer = system 'Scenario Mixer' {
    description 'Applies choice-model parameters to annual results and returns a styled scenario mixture'
    icon gcp:advanced-agent-modeling

    siteEnergyResult = result 'SiteEnergyResult' {
      description 'Annual per-building site energy results loaded from persistence'
      icon gcp:big-query
    }

    choiceModel = stage 'Choice Model' {
      description 'Converts modeling parameters and API requests into mixer parameters'
      icon gcp:vertex-ai
    }

    modeledMixtureSelection = stage 'Modeled Mixture Selection' {
      description 'Applies mixer parameters to the modeled scenario mixture'
      icon gcp:recommendations-ai
    }

    scenarioResults = result 'Scenario Results' {
      description 'Real-time scenario aggregation returned to the WebUI'
      icon gcp:looker
    }
  }

  gisTables = system 'GIS Tables' {
    description 'GIS properties and selected result projections'
    icon gcp:google-maps-platform
    style {
      shape storage
    }

    gisPropertiesTable = table 'GIS Properties Table' {
      description 'Stores processed feature properties for GIS export'
    }

    gisResultTable = table 'GIS Result Table' {
      description 'Stores a selective GIS projection of site energy results'
    }
  }

  resultsGeojson = output 'Results GeoJSON' {
    description 'GeoJSON exported from GIS properties and GIS results'
    icon gcp:cloud-storage
  }

  inputs.inputGeojson -> preprocessing 'feature data'
  preprocessing -> gisTables.gisPropertiesTable 'processed collection data'
  preprocessing -> feature2Building.feature 'emits'
  preprocessing -> scenarioMappings 'feeds'

  feature2Building.building -> definitionTables.buildingDefinitionTable 'writes definition'
  feature2Building.zones -> definitionTables.zoneDefinitionTable 'writes definition + load series'
  feature2Building.zones -> simulation.precomputeBoundary.localWeather 'zone geometry + location'
  feature2Building.zones -> baselineSimulation 'zone geometry + location'
  feature2Building -> buildingUpgradeScenarios 'Copy of Building'
  scenarioMappings -> buildingUpgradeScenarios 'applied selections and scenario measures'
  buildingUpgradeScenarios -> definitionTables
  buildingUpgradeScenarios -> simulation 'copy of instance'
  baselineSimulation -> simulation

  simulation.precomputeBoundary.boundaryConditions -> simulation.zone5R1C 'boundary conditions'
  inputs.weather -> simulation.precomputeBoundary.localWeather 'weather input'
  inputs.weather -> simulation.precomputeBoundary.faceRadiation 'weather input'
  inputs.weather -> simulation.zone5R1C 'weather input'
  simulation.zone5R1C -> simulation.resultsAggregation.zoneResult 'emits'
  feature2Building.energyLoadsArchetype -> simulation.resultsAggregation.siteEnergyResult 'supplies External loads'

  simulation.precomputeBoundary -> resultTables.zoneResultTable 'writes boundary results'
  simulation.resultsAggregation.zoneResult -> resultTables.zoneResultTable 'persists'
  simulation.resultsAggregation.buildingResult -> resultTables.buildingResultTable 'persists'
  simulation.resultsAggregation.siteEnergyResult -> resultTables.siteEnergyResultTable 'persists'

  resultTables.siteEnergyResultTable -> scenarioMixer.siteEnergyResult 'BuildingId, Annual Results'
  mixerInput -> scenarioMixer.choiceModel 'Modeling Parameters'
  scenarioMixer.choiceModel -> scenarioMixer.modeledMixtureSelection 'Mixer Parameters'
  webUI -> scenarioMixer.choiceModel 'API Call with Mixer Parameters'
  scenarioMixer.siteEnergyResult -> scenarioMixer.modeledMixtureSelection
  scenarioMixer.modeledMixtureSelection -> scenarioMixer.scenarioResults 'Real Time Aggregation'
  scenarioMixer.scenarioResults -> webUI 'API Response Triggering Style Update'

  simulation.resultsAggregation.siteEnergyResult -> gisTables.gisResultTable 'selective GIS projection'
  gisTables.gisPropertiesTable -> resultsGeojson 'exports properties'
  gisTables.gisResultTable -> resultsGeojson 'exports results'
}
